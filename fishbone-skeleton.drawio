nt x="730.7" y="326.0" as="sourcePoint"/><mxPoint x="950.7" y="326.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e114" value="" style="endArrow=classic;html=1;strokeWidth=1.4;edgeStyle=none;strokeColor=#8aa2b8;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="693.7" y="262.0" as="sourcePoint"/><mxPoint x="913.7" y="262.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e115" value="" style="endArrow=none;html=1;strokeWidth=2;edgeStyle=none;strokeColor=#2f6fb5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540.0" y="550.0" as="sourcePoint"/><mxPoint x="355.2" y="870.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r116" value="人" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#2f6fb5;fontSize=17;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="1"><mxGeometry x="300.2" y="876.0" width="110.0" height="40.0" as="geometry"/></mxCell><mxCell id="e117" value="" style="endArrow=classic;html=1;strokeWidth=1.4;edgeStyle=none;strokeColor=#8aa2b8;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="264.6" y="646.0" as="sourcePoint"/><mxPoint x="484.6" y="646.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e118" value="" style="endArrow=classic;html=1;strokeWidth=1.4;edgeStyle=none;strokeColor=#8aa2b8;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="227.6" y="710.0" as="sourcePoint"/><mxPoint x="447.6" y="710.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e119" value="" style="endArrow=classic;html=1;strokeWidth=1.4;edgeStyle=none;strokeColor=#8aa2b8;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190.7" y="774.0" as="sourcePoint"/><mxPoint x="410.7" y="774.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e120" value="" style="endArrow=classic;html=1;strokeWidth=1.4;edgeStyle=none;strokeColor=#8aa2b8;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="153.7" y="838.0" as="sourcePoint"/><mxPoint x="373.7" y="838.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e121" value="" style="endArrow=none;html=1;strokeWidth=2;edgeStyle=none;strokeColor=#2f6fb5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000.0" y="550.0" as="sourcePoint"/><mxPoint x="815.2" y="870.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r122" value="方法" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#2f6fb5;fontSize=17;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="1"><mxGeometry x="760.2" y="876.0" width="110.0" height="40.0" as="geometry"/></mxCell><mxCell id="e123" value="" style="endArrow=classic;html=1;strokeWidth=1.4;edgeStyle=none;strokeColor=#8aa2b8;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="724.6" y="646.0" as="sourcePoint"/><mxPoint x="944.6" y="646.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e124" value="" style="endArrow=classic;html=1;strokeWidth=1.4;edgeStyle=none;strokeColor=#8aa2b8;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="687.6" y="710.0" as="sourcePoint"/><mxPoint x="907.6" y="710.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e125" value="" style="endArrow=classic;html=1;strokeWidth=1.4;edgeStyle=none;strokeColor=#8aa2b8;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650.7" y="774.0" as="sourcePoint"/><mxPoint x="870.7" y="774.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e126" value="" style="endArrow=classic;html=1;strokeWidth=1.4;edgeStyle=none;strokeColor=#8aa2b8;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="613.7" y="838.0" as="sourcePoint"/><mxPoint x="833.7" y="838.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e127" value="" style="endArrow=none;html=1;strokeWidth=1.2;edgeStyle=none;strokeColor=#b0bfcd;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="494.6" y="454.0" as="sourcePoint"/><mxPoint x="494.6" y="512.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e128" value="" style="endArrow=classic;html=1;strokeWidth=1.2;edgeStyle=none;strokeColor=#b0bfcd;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="386.6" y="483.0" as="sourcePoint"/><mxPoint x="494.6" y="483.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e129" value="" style="endArrow=classic;html=1;strokeWidth=1.2;edgeStyle=none;strokeColor=#b0bfcd;endSize=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="386.6" y="512.0" as="sourcePoint"/><mxPoint x="494.6" y="512.0" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="guide" name="使用说明"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="880" pageHeight="440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g0" value="用这张骨架，5 分钟画完鱼骨图" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=24;fontColor=#2c3e50;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="760" height="40" as="geometry"/></mxCell><mxCell id="g1" value="【1】改文字：双击任何一个词，直接打自己的内容。大骨已填「材料 / 设备 / 人 / 方法」，改成你要的分类。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#2c3e50;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="780" height="30" as="geometry"/></mxCell><mxCell id="g2" value="【2】加中骨（水平线）：点中任意一根中骨 → Ctrl+C → Ctrl+V → 拖到新位置。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#2c3e50;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="780" height="30" as="geometry"/></mxCell><mxCell id="g3" value="【3】加小骨：小骨和中骨一样是水平线。复制一根中骨，缩短，再用一根竖线接到中骨上（见左上角示范）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#2c3e50;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="780" height="50" as="geometry"/></mxCell><mxCell id="g4" value="【4】加一根大骨：连大骨在内的整体复制。拖端点时若线拐成直角，选中线 → 右侧「样式」→ Line 改成 Straight(直线)。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#2c3e50;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="780" height="50" as="geometry"/></mxCell><mxCell id="g5" value="【5】配色：右侧「样式」里改线条颜色和粗细，把重点要因加粗或标红。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#2c3e50;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="780" height="30" as="geometry"/></mxCell><mxCell id="g6" value="【6】画完导出：文件 → 导出为 → SVG，交给 AI 就能做成逐笔生长的动画。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontColor=#2c3e50;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="780" height="30" as="geometry"/></mxCell><mxCell id="g7" value="几何规格：主骨 / 中骨 / 小骨 全部水平（互相平行），只有大骨是 60° 斜线。这是标准鱼骨图的画法。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#2c3e50;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="780" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>